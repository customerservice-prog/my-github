# Platform
NODE_ENV=production
PLATFORM_NAME=My GitHub
CONTROL_DOMAIN=dev.example.com
GIT_DOMAIN=git.example.com
STORAGE_DOMAIN=storage.example.com
STORAGE_CONSOLE_DOMAIN=storage-admin.example.com
GRAFANA_DOMAIN=metrics.example.com
STATUS_DOMAIN=status.example.com
# Wildcard DNS: *.preview.example.com -> this deployment server
PREVIEW_BASE_DOMAIN=preview.example.com
ACME_EMAIL=admin@example.com

# Bootstrap administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately

# Security: use openssl rand -base64 48 for SESSION_SECRET and INTERNAL_API_TOKEN
SESSION_SECRET=replace-with-a-long-random-secret
INTERNAL_API_TOKEN=replace-with-a-long-random-token
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
MASTER_KEY=replace-with-32-byte-base64-key
WEBHOOK_SECRET=replace-with-random-webhook-secret

# Control plane database
POSTGRES_DB=mygithub
POSTGRES_USER=mygithub
POSTGRES_PASSWORD=replace-platform-db-password
DATABASE_URL=postgresql://mygithub:replace-platform-db-password@postgres:5432/mygithub

# Managed application PostgreSQL
APP_DB_ADMIN_USER=appadmin
APP_DB_ADMIN_PASSWORD=replace-app-db-admin-password
APP_DATABASE_ADMIN_URL=postgresql://appadmin:replace-app-db-admin-password@app-postgres:5432/postgres

# Redis
REDIS_URL=redis://redis:6379

# Forgejo
FORGEJO_ADMIN_USER=admin
FORGEJO_ADMIN_EMAIL=admin@example.com
FORGEJO_ADMIN_PASSWORD=replace-forgejo-admin-password
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=replace-forgejo-db-password
FORGEJO_INTERNAL_URL=http://forgejo:3000
FORGEJO_PUBLIC_URL=https://git.example.com
# Comma-separated HTTPS hosts accepted by repository import.
GIT_IMPORT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
# Optional API token. If empty, Basic auth uses admin user/password.
FORGEJO_TOKEN=
FORGEJO_USER=admin
FORGEJO_PASSWORD=replace-forgejo-admin-password

# Container registry. Forgejo's OCI registry works at the Forgejo host.
REGISTRY_HOST=git.example.com
REGISTRY_NAMESPACE=admin
REGISTRY_USER=admin
REGISTRY_PASSWORD=replace-forgejo-admin-password

# Local deployment agent
LOCAL_AGENT_URL=http://agent:7001
LOCAL_AGENT_TOKEN=replace-with-a-long-random-agent-token
TRAEFIK_DYNAMIC_DIR=/dynamic

# Backups
BACKUP_INTERVAL_SECONDS=21600
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD=replace-with-a-long-restic-password
# For off-site S3 backups, set RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Object storage
MINIO_ROOT_USER=mygithub
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_MC_IMAGE=minio/mc:RELEASE.2026-09-19T15-24-59Z

# Observability
# Optional generic JSON webhook for site/server transition alerts.
ALERT_WEBHOOK_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
